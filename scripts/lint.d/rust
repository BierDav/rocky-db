# shellcheck shell=sh disable=SC2034 # scripts/lint reads the module's variables
# Rust formatting. Clippy needs a build and runs in scripts/check.
tools=
# Every Cargo workspace outside the root one; benchmarks keep their own rules.
manifests=''

check() {
    cargo fmt --all -- --check
    for manifest in $manifests; do cargo fmt --manifest-path "$manifest" -- --check; done
}

fix() {
    cargo fmt --all
    for manifest in $manifests; do cargo fmt --manifest-path "$manifest"; done
}

# shellcheck disable=SC2016 # jj expands $root and $path
jj_fix_command='["rustfmt", "--config-path", "$root/rustfmt.toml"]'
jj_fix_patterns="[\"glob:'**/*.rs' ~ glob:'benchmarks/engine-comparison/**' ~ glob:'benchmarks/engine-scale/**'\"]"
