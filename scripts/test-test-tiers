#!/usr/bin/env python3
"""Regression tests for correctness reporting; run by scripts/lint."""
import contextlib
import importlib.machinery
import importlib.util
import io
import json
from pathlib import Path
from types import SimpleNamespace
import unittest
from unittest.mock import patch

loader = importlib.machinery.SourceFileLoader("test_tiers", str(Path(__file__).with_name("test-tiers")))
spec = importlib.util.spec_from_loader(loader.name, loader)
tiers = importlib.util.module_from_spec(spec)
loader.exec_module(tiers)


class CorrectnessReporting(unittest.TestCase):
    def test_slow_successes_pass_and_failures_still_fail(self):
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            self.assertFalse(tiers.finish_tier(None, "e2e", {"timed": [None], "wall": 10000, "problems": []}))
            self.assertTrue(tiers.finish_tier(None, "e2e", {"timed": [], "wall": 0, "problems": ["assertion failed"]}))

    def test_abnormal_exit_after_passing_events_still_fails(self):
        suite = {"binary-id": "unit", "binary-path": "/binary"}
        with patch.object(tiers, "libtest", return_value=({"case": ("ok", 0.0, "")}, "", 101)):
            _, failed, _ = tiers.run_unit(None, [(suite, "case")])
        self.assertEqual(failed, ["unit exited 101"])


class BatchedExecution(unittest.TestCase):
    def test_batches_cover_each_selected_case_once_without_mixing_binaries(self):
        left = {"binary-id": "left", "binary-path": "/left"}
        right = {"binary-id": "right", "binary-path": "/right"}
        tests = [(left, f"case_{i}") for i in range(65)] + [(right, "case_0")]
        groups = tiers.batches(tests)
        self.assertEqual([len(names) for _, names in groups], [32, 32, 1, 1])
        self.assertEqual([(suite, name) for suite, names in groups for name in names], tests)

    def test_batching_preserves_assertion_missing_result_and_exit_failures(self):
        suite = {"binary-id": "binary", "binary-path": "/binary"}
        events = {"ok": ("ok", 0.1, ""), "bad": ("failed", 0.0, "assertion failed")}
        with patch.object(tiers, "libtest", return_value=(events, "", 101)), contextlib.redirect_stdout(io.StringIO()):
            timed, failed, _ = tiers.run_batches(None, [(suite, name) for name in ("ok", "bad", "missing")])
        self.assertEqual([name for _, _, name, _ in timed], ["ok"])
        self.assertEqual(set(failed), {"binary exited 101", "binary bad: failed", "binary missing: missing"})

    def test_isolated_cases_are_excluded_from_batches_and_all_results_combine(self):
        suite = {"binary-id": "binary", "binary-path": "/binary"}
        isolated, shared = (suite, "isolated"), (suite, "shared")
        source = SimpleNamespace(list=lambda expr: [isolated])
        config = SimpleNamespace(tiers={"integration": {"isolated-filter": "test(=isolated)"}})
        with patch.object(tiers, "run_nextest", return_value=([isolated], ["isolated failed"], 1.0)), \
                patch.object(tiers, "run_batches", return_value=([shared], [], 2.0)) as batch:
            timed, failed, wall = tiers.run_tier(source, config, "integration", "all()", [isolated, shared])
        batch.assert_called_once_with(source, [shared])
        self.assertEqual(timed, [isolated, shared])
        self.assertEqual(failed, ["isolated failed"])
        self.assertEqual(wall, 3.0)


class ArchivedExecutables(unittest.TestCase):
    def test_confirmation_uses_the_package_executable_from_the_archive(self):
        source = tiers.Source(archive="workspace.tar.zst")
        suite = {"binary-id": "coordinator::public", "package-id": "coordinator",
                 "binary-path": "/extracted/target/debug/deps/public", "cwd": "/workspace",
                 "testcases": {"example": {"filter-match": {"status": "matches"}}}}
        metadata = {"rust-build-meta": {"target-directory": "/original/target",
                    "non-test-binaries": {
                        "coordinator": [{"kind": "bin-exe", "name": "rocky-voter", "path": "debug/rocky-voter"}],
                        "other": [{"kind": "bin-exe", "name": "other", "path": "debug/other"}]}},
                    "rust-suites": {"public": suite}}
        listing = SimpleNamespace(returncode=0, stdout=json.dumps(metadata))
        execution = SimpleNamespace(stdout='', stderr='', returncode=0)
        with patch.object(tiers.subprocess, "run", side_effect=[listing, execution]) as run:
            [(record, name)] = source.list("all()")
            tiers.libtest(record, [name], threads=1)
        environment = run.call_args.kwargs["env"]
        self.assertEqual(environment["CARGO_BIN_EXE_rocky-voter"], str(source.target_dir / "debug/rocky-voter"))
        self.assertNotIn("CARGO_BIN_EXE_other", environment)


class MultiTier(unittest.TestCase):
    def test_features_are_grouped_and_failures_combine_both_builds(self):
        events = []
        sources = []
        def source(build, cranelift):
            obj = SimpleNamespace(name=build, list=lambda expr, ignored: [(None, build)])
            sources.append(obj)
            return obj
        def run(source, config, tier, expr, tests):
            self.assertEqual(expr, f"({tier}) & (package(=app))")
            events.append((source.name, tier))
            suite = {"binary-id": source.name}
            return [(source, suite, "test", 0.001)], ["regression"] if tier == "unit" else [], 2.0
        config = SimpleNamespace(filters={"unit": "unit", "integration": "integration"})
        states = {}
        def finish(config, tier, state):
            states[tier] = state
            return bool(state["problems"])
        import tempfile
        with tempfile.TemporaryDirectory() as directory, \
                patch.object(tiers, "REPORTS", Path(directory)), \
                patch.object(tiers, "Config", return_value=config), \
                patch.object(tiers, "Source", side_effect=source), \
                patch.object(tiers, "run_tier", side_effect=run), \
                patch.object(tiers, "finish_tier", side_effect=finish), \
                patch.object(tiers.sys, "argv", ["test-tiers", "unit", "integration",
                                                   "--build=default", "--build=without-defaults",
                                                   "--filter", "package(=app)"]), \
                contextlib.redirect_stdout(io.StringIO()), self.assertRaises(SystemExit) as exit:
            tiers.main()
        self.assertEqual(exit.exception.code, 1)
        self.assertEqual(events, [("default", "unit"), ("default", "integration"),
                                  ("without-defaults", "unit"), ("without-defaults", "integration")])
        for state in states.values():
            self.assertEqual(state["wall"], 4.0)
            self.assertEqual(len(state["timed"]), 2)
        self.assertEqual(len(states["unit"]["problems"]), 2)


scope_loader = importlib.machinery.SourceFileLoader("check_scope", str(Path(__file__).with_name("check-scope")))
scope_spec = importlib.util.spec_from_loader(scope_loader.name, scope_loader)
scope = importlib.util.module_from_spec(scope_spec)
scope_loader.exec_module(scope)


class Scope(unittest.TestCase):
    def packages(self):
        return [
            {"name": "core", "manifest_path": "/repo/crates/core/Cargo.toml", "dependencies": []},
            {"name": "runtime", "manifest_path": "/repo/crates/runtime/Cargo.toml",
             "dependencies": [{"name": "renamed", "path": "/repo/crates/core", "kind": "dev", "target": "cfg(windows)"}]},
            {"name": "app", "manifest_path": "/repo/examples/app/Cargo.toml",
             "dependencies": [{"path": "/repo/crates/runtime"}]},
            {"name": "other", "manifest_path": "/repo/crates/other/Cargo.toml", "dependencies": []},
        ]

    def test_transitive_consumers_include_renamed_dev_and_platform_dependencies(self):
        self.assertEqual(scope.consumers(self.packages(), {"core"}), ["app", "core", "runtime"])
        self.assertEqual(scope.consumers(self.packages(), {"app"}), ["app"])

    def test_source_and_test_changes_select_the_owner(self):
        self.assertEqual(scope.changed_packages(self.packages(),
            ["crates/core/src/lib.rs", "examples/app/tests/deleted.rs"], Path("/repo")), {"core", "app"})

    def test_unknown_shared_and_manifest_inputs_fall_back_to_everything(self):
        for paths in ([], ["Cargo.lock"], ["crates/core/Cargo.toml"], [".cargo/config.toml"],
	                      ["scripts/check"], ["crates/core/src/lib.rs", "vendor/lib.rs"],
	                      ["sdks/legacy/src/lib.rs"]):
            with self.subTest(paths=paths):
                self.assertIsNone(scope.changed_packages(self.packages(), paths, Path("/repo")))


ios_loader = importlib.machinery.SourceFileLoader("ios_results", str(Path(__file__).parent / "ci" / "ios-test-results"))
ios = importlib.util.module_from_spec(importlib.util.spec_from_loader(ios_loader.name, ios_loader))
ios_loader.exec_module(ios)


class IosCorrectness(unittest.TestCase):
    def test_slow_success_is_accepted(self):
        self.assertEqual(ios.results("[==========] Running 1 tests\n[       OK ] example (999999 ms)\n[  PASSED  ] 1 tests"), {"example": 999999})

    def test_missing_failed_and_duplicate_results_are_refused(self):
        for text in ("", "[==========] Running 2 tests\n[  PASSED  ] 1 tests",
                     "[==========] Running 2 tests\n[       OK ] same (0 ms)\n[       OK ] same (0 ms)\n[  PASSED  ] 2 tests"):
            with self.subTest(text=text), self.assertRaises(ValueError):
                ios.results(text)


if __name__ == "__main__":
    unittest.main()
